# =============================================
# BASE DE DATOS
# =============================================
MONGODB=mongodb+srv://usuario:password@cluster.mongodb.net/
PORT=3005

# =============================================
# JWT
# =============================================
JWT_SECRET=cambia_este_secreto_en_produccion

# =============================================
# MERCADO PAGO - CREDENCIALES DE LA APLICACIÓN
# =============================================
# Obtenelas en: https://www.mercadopago.com/developers/panel/app
# Seleccioná tu aplicación → Credenciales

# App ID (también llamado Client ID)
MP_APP_ID=123456789

# Client Secret (usado para OAuth)
MP_CLIENT_SECRET=TU_CLIENT_SECRET

# Public Key de TEST (la usa el frontend)
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Access Token de TEST (la usa el backend para crear preferencias propias)
# Usalo SOLO si los proveedores NO tienen cuenta de MP conectada
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx

# =============================================
# MERCADO PAGO - CONFIGURACIÓN OAUTH (Marketplace)
# =============================================
# URL a la que MP redirige después del OAuth del proveedor
# Debe estar dada de alta en el panel de MP (Aplicación → Redirect URIs)
MP_REDIRECT_URI=https://gestor-turnos-backend.onrender.com/api/mercadopago/oauth/callback

# =============================================
# MERCADO PAGO - WEBHOOKS
# =============================================
# URL donde MP envía notificaciones de pago
MP_WEBHOOK_URL=https://gestor-turnos-backend.onrender.com/api/mercadopago/webhook

# Clave para validar la firma del webhook (la encontrás en el panel de MP)
MP_WEBHOOK_SECRET=TU_WEBHOOK_SECRET

# =============================================
# CORS (orígenes permitidos del frontend, separados por coma)
# =============================================
# Importante: el frontend corre en local (Vite, puerto 5173) pero pega contra el
# backend de Render, así que el deploy de Render TIENE que incluir estos orígenes.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Cuando se despliegue el front, agregar su dominio a la lista:
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://gestor-turnos-frontend.vercel.app

# =============================================
# N8N - AUTOMATIZACIONES (recordatorios y emails)
# =============================================
# Secreto compartido que n8n manda en el header X-N8N-Secret
# para llamar a los endpoints de recordatorios (no requieren JWT de usuario)
N8N_SHARED_SECRET=cambia_este_secreto

# Instancia de n8n desplegada en Railway
# Webhook de n8n que se dispara al crear un turno (envía el mail de bienvenida)
N8N_WEBHOOK_TURNO_CREADO=https://primary-production-e79b2.up.railway.app/webhook/turno-creado

# Webhook de n8n que se dispara al cancelar todos los turnos de un día
N8N_WEBHOOK_CANCELACION_DIA=https://primary-production-e79b2.up.railway.app/webhook/cancelacion-dia

# Chat de Telegram al que llegan los recordatorios del proveedor.
# Se aplica a los proveedores nuevos y como fallback para los que no cargaron el suyo,
# así la automatización anda sin que el proveedor configure nada.
# Lo obtenés escribiéndole a @userinfobot en Telegram.
TELEGRAM_DEFAULT_CHAT_ID=123456789

# =============================================
# ZONA HORARIA
# =============================================
# El backend guarda la fecha como medianoche LOCAL del proceso y después recompone
# fecha+horaInicio con la misma zona. Si el server corre en UTC (default de Render),
# un turno de las 15:00 ART se evalúa como 15:00 UTC y los recordatorios salen 3h antes.
TZ=America/Argentina/Buenos_Aires

# =============================================
# FRONTEND
# =============================================
# Origen del frontend. De acá se derivan las back_urls de Mercado Pago
# (/pagos/exito, /pagos/error, /pagos/pendiente) y los redirects del callback
# de OAuth (/configuracion/mp-conectado, /configuracion/mp-error).
# Frontend corriendo local con Vite:
FRONTEND_URL=http://localhost:5173
# Cuando se despliegue el front, cambiar por su dominio público. Recién ahí MP
# habilita auto_return y redirige solo tras el pago (con localhost no lo acepta):
# FRONTEND_URL=https://gestor-turnos-frontend.vercel.app
