# =============================================
# BASE DE DATOS
# =============================================
MONGODB=mongodb+srv://usuario:password@cluster.mongodb.net/
PORT=3005

# =============================================
# JWT
# =============================================
JWT_SECRET=cambia_este_secreto_en_produccion

# =============================================
# MERCADO PAGO - CREDENCIALES DE LA APLICACIÓN
# =============================================
# Obtenelas en: https://www.mercadopago.com/developers/panel/app
# Seleccioná tu aplicación → Credenciales

# App ID (también llamado Client ID)
MP_APP_ID=123456789

# Client Secret (usado para OAuth)
MP_CLIENT_SECRET=TU_CLIENT_SECRET

# Public Key de TEST (la usa el frontend)
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Access Token de TEST (la usa el backend para crear preferencias propias)
# Usalo SOLO si los proveedores NO tienen cuenta de MP conectada
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx

# =============================================
# MERCADO PAGO - CONFIGURACIÓN OAUTH (Marketplace)
# =============================================
# URL a la que MP redirige después del OAuth del proveedor
# En desarrollo: tu URL de ngrok + /api/mercadopago/oauth/callback
MP_REDIRECT_URI=http://localhost:3005/api/mercadopago/oauth/callback

# =============================================
# MERCADO PAGO - WEBHOOKS
# =============================================
# URL donde MP envía notificaciones de pago
# En desarrollo: usar ngrok (ej: https://abc123.ngrok.io/api/mercadopago/webhook)
MP_WEBHOOK_URL=https://TU_NGROK_URL/api/mercadopago/webhook

# Clave para validar la firma del webhook (la encontrás en el panel de MP)
MP_WEBHOOK_SECRET=TU_WEBHOOK_SECRET

# =============================================
# FRONTEND
# =============================================
# URLs de redirección después del pago (deben existir en tu frontend)
FRONTEND_URL=http://localhost:3000
FRONTEND_SUCCESS_URL=http://localhost:3000/pagos/exito
FRONTEND_FAILURE_URL=http://localhost:3000/pagos/error
FRONTEND_PENDING_URL=http://localhost:3000/pagos/pendiente
